--- !u!114 &2051531753
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2051531745}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6c4e397e1cca190408723f0614919fc2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  welcomePhrase: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0434\u0440\u0443\u0436\u043E\u043A!
    \u0420\u0430\u0434 \u0442\u0435\u0431\u044F \u0432\u0438\u0434\u0435\u0442\u044C!
    \u042F \u0432\u0435\u0442\u0440\u0438\u043A."
  welcomeAudio: {fileID: 8300000, guid: fdae2937323e48846900fe98c105c81b, type: 3}
  phrases:
  - vetrikasPhrases: "\u0413\u043E\u0442\u043E\u0432 \u043A \u0432\u0435\u0441\u0435\u043B\u044C\u044E?
      \u042F - \u0434\u0430!"
    audioClip: {fileID: 8300000, guid: 7a596d78c101f5b41be8201f92cda080, type: 3}
  - vetrikasPhrases: "\u0422\u044B \u043C\u043E\u0439 \u043B\u0443\u0447\u0448\u0438\u0439
      \u0438\u0433\u0440\u043E\u043A! \u0422\u0441\u0441, \u044D\u0442\u043E \u0441\u0435\u043A\u0440\u0435\u0442."
    audioClip: {fileID: 8300000, guid: 80c021d7ab19d014692482f918d17c72, type: 3}
  - vetrikasPhrases: "\u041E\u0439, \u0449\u0435\u043A\u043E\u0442\u043D\u043E!"
    audioClip: {fileID: 8300000, guid: 6beb52a68bbf65e40839e288ede09dbb, type: 3}
  - vetrikasPhrases: "\u0417\u043D\u0430\u0435\u0448\u044C, \u0447\u0442\u043E \u044F
      \u043B\u044E\u0431\u043B\u044E \u043D\u0430 \u0437\u0430\u0432\u0442\u0440\u0430\u043A?
      \u041F\u0438\u043A\u0441\u0435\u043B\u044C\u043D\u044B\u0435 \u0431\u043B\u0438\u043D\u0447\u0438\u043A\u0438!"
    audioClip: {fileID: 8300000, guid: 974bda0e78df7c1418d3ff68fb2caa00, type: 3}
  - vetrikasPhrases: "\u041C\u043E\u0439 \u043B\u044E\u0431\u0438\u043C\u044B\u0439
      \u0446\u0432\u0435\u0442? \u041A\u043E\u043D\u0435\u0447\u043D\u043E, \u0438\u0433\u0440\u043E\u0432\u043E\u0439!"
    audioClip: {fileID: 8300000, guid: 66b01e57ef9b1724ba3207b4239f377c, type: 3}
  - vetrikasPhrases: "\u0415\u0441\u043B\u0438 \u044F \u0438\u0441\u0447\u0435\u0437\u043D\u0443
      - \u043D\u0435 \u0432\u043E\u043B\u043D\u0443\u0439\u0441\u044F, \u044F \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u043E\u0448\u0451\u043B \u0437\u0430 \u0432\u0438\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u043C
      \u043F\u0435\u0447\u0435\u043D\u044C\u0435\u043C."
    audioClip: {fileID: 8300000, guid: 6c956246e77587a47b6a2aefa6a2ba68, type: 3}
  - vetrikasPhrases: "\u041F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0439
      \u0434\u0435\u043D\u044C \u0434\u043B\u044F \u0438\u0433\u0440, \u0442\u044B
      \u043D\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u0448\u044C?"
    audioClip: {fileID: 8300000, guid: 5281e8522665f314e995388a46267b67, type: 3}
  - vetrikasPhrases: "\u0412\u0438\u0434\u0438\u0448\u044C \u044D\u0442\u0443 \u0441\u0438\u044F\u044E\u0449\u0443\u044E
      \u043A\u043D\u043E\u043F\u043A\u0443 \"\u0418\u0433\u0440\u0430\u0442\u044C\"?
      \u041E\u043D\u0430 \u0442\u043E\u0447\u043D\u043E \u0437\u043E\u0432\u0451\u0442
      \u0442\u0435\u0431\u044F \u0432 \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435!"
    audioClip: {fileID: 8300000, guid: 5a25903972038b44da0a8ce66c6030b7, type: 3}
  - vetrikasPhrases: "\u041D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439 \u043F\u0440\u043E
      \u043C\u0435\u043D\u044E \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043A.
      \u0422\u0430\u043C \u043C\u043E\u0436\u043D\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u0438\u0433\u0440\u0443 \u0443\u0434\u043E\u0431\u043D\u0435\u0435 \u0438\u043C\u0435\u043D\u043D\u043E
      \u0434\u043B\u044F \u0442\u0435\u0431\u044F!"
    audioClip: {fileID: 8300000, guid: 7b1dddf09443f244aabeca06b59110a3, type: 3}
  - vetrikasPhrases: "\u0413\u043E\u0442\u043E\u0432 \u043A \u043F\u043E\u043B\u0451\u0442\u0443?
      \u0422\u043E\u0433\u0434\u0430 \u0436\u043C\u0438 \u201C\u0418\u0433\u0440\u0430\u0442\u044C\u201D
      \u0438 \u043F\u043E\u043B\u0435\u0442\u0435\u043B\u0438!"
    audioClip: {fileID: 8300000, guid: 58d4a974e4db5eb47a5dc85524991518, type: 3}
