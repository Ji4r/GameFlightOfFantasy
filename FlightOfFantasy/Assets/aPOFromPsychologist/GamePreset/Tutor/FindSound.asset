  m_Script: {fileID: 11500000, guid: 683afb59319d7ff4785863a4e3cd9bc4, type: 3}
  m_Name: FindSound
  m_EditorClassIdentifier: 
  tutor:
  - Text: "\u0421\u0443\u0442\u044C \u0438\u0433\u0440\u044B \u0438 \u043A\u0430\u043A
      \u0438\u0433\u0440\u0430\u0442\u044C: \u042D\u0442\u043E \u0438\u0433\u0440\u0430
      \xAB\u041D\u0430\u0439\u0434\u0438 \u0437\u0432\u0443\u043A\xBB. \u0412\u0438\u0434\u0438\u0448\u044C
      \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0443 \u0438 \u0442\u0440\u0438
      \u0437\u0432\u0443\u043A\u0430? \u0422\u0432\u043E\u044F \u0437\u0430\u0434\u0430\u0447\u0430
      \u2014 \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0437\u0432\u0443\u043A,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u043A \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0435. \u041F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0430\u0436\u0438\u043C\u0430\u0439 \u043D\u0430 \u0437\u0432\u0443\u043A\u0438,
      \u0441\u043B\u0443\u0448\u0430\u0439 \u0438\u0445 \u0438 \u043F\u0435\u0440\u0435\u0442\u0430\u0449\u0438
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442
      \u0432 \u0446\u0435\u043D\u0442\u0440 \u044D\u043A\u0440\u0430\u043D\u0430.
      \u0414\u0430\u0432\u0430\u0439 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C!\xBB "
    AudioClip: {fileID: 0}
    VideoClip: {fileID: 32900000, guid: 9d24740fe02f44f4ab05fe5a5e393f6b, type: 3}
  - Text: "\u0427\u0430\u0441\u0442\u044B\u0435 \u043E\u0448\u0438\u0431\u043A\u0438
      \u0438 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438: \xAB\u0412\u043E\u0442
      \u0447\u0442\u043E \u0432\u0430\u0436\u043D\u043E \u043F\u043E\u043C\u043D\u0438\u0442\u044C:
      \u2014 \u0415\u0441\u043B\u0438 \u0437\u0432\u0443\u043A \u043D\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u2014 \u043D\u0435 \u0442\u044F\u043D\u0438 \u0435\u0433\u043E \u0432 \u0446\u0435\u043D\u0442\u0440,
      \u043E\u043D \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F \u043D\u0430\u0437\u0430\u0434.
      \u2014 \u041D\u0430\u0436\u0438\u043C\u0430\u0439 \u043D\u0430 \u0437\u0432\u0443\u043A\u0438
      \u043F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438, \u0447\u0442\u043E\u0431\u044B
      \u0441\u0440\u0430\u0432\u043D\u0438\u0442\u044C \u0438\u0445. \u2014 \u0415\u0441\u043B\u0438
      \u043E\u0448\u0438\u0431\u0451\u0448\u044C\u0441\u044F \u2014 \u043D\u0438\u0447\u0435\u0433\u043E
      \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E! \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439
      \u0435\u0449\u0451 \u0440\u0430\u0437. \u0413\u043E\u0442\u043E\u0432 \u043F\u0440\u043E\u044F\u0432\u0438\u0442\u044C
      \u0441\u043B\u0443\u0445? \u0412\u043F\u0435\u0440\u0451\u0434!\xBB "
    AudioClip: {fileID: 0}
    VideoClip: {fileID: 32900000, guid: 1792896652e6ae04496508382bdc1ea0, type: 3}
