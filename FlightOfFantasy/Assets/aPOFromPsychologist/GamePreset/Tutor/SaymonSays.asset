MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 683afb59319d7ff4785863a4e3cd9bc4, type: 3}
  m_Name: SaymonSays
  m_EditorClassIdentifier: 
  tutor:
  - Text: "\u041A\u0430\u043A \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
      \u0438\u0433\u0440\u0430\u0442\u044C: \xAB\u0412\u0435\u0442\u0440\u0438\u043A
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442\xBB! \u041A\u0440\u0443\u0433 \u043F\u043E\u043A\u0430\u0436\u0435\u0442
      \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u0446\u0432\u0435\u0442\u043E\u0432 \u2014 \r\n\u0437\u0430\u043F\u043E\u043C\u043D\u0438
      \u0435\u0451. \u0417\u0430\u0442\u0435\u043C \u043F\u043E\u0432\u0442\u043E\u0440\u0438
      \u044D\u0442\u0443 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C,
      \u043D\u0430\u0436\u0438\u043C\u0430\u044F \u043D\u0430 \u0446\u0432\u0435\u0442\u0430
      \u0432\u043D\u0438\u0437\u0443\xBB"
    AudioClip: {fileID: 8300000, guid: e5dcb5cf7de21ca45b1583366a373e55, type: 3}
    VideoClip: {fileID: 32900000, guid: 80f72f48d8ef67d47ad002d1c59d2d96, type: 3}
  - Text: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430:\r\n\xAB\u0412\u043A\u043B\u044E\u0447\u0438
      \u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E \u0438 \u0441\u043B\u0443\u0445\u043E\u0432\u0443\u044E
      \u043F\u0430\u043C\u044F\u0442\u044C:\r\n\u2014 \u041A\u0430\u0436\u0434\u044B\u0439
      \u0446\u0432\u0435\u0442 \u0437\u0432\u0443\u0447\u0438\u0442 \u0441\u0432\u043E\u0435\u0439
      \u043D\u043E\u0442\u043E\u0439, \u044D\u0442\u043E \u043F\u043E\u043C\u043E\u0436\u0435\u0442.\r\n\u2014
      \u0415\u0441\u043B\u0438 \u043E\u0448\u0438\u0431\u0451\u0448\u044C\u0441\u044F
      \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
      \u2014 \u0438\u0433\u0440\u0430 \u043D\u0430\u0447\u043D\u0451\u0442\u0441\u044F
      \u0437\u0430\u043D\u043E\u0432\u043E.\r\n\u2014 \u041D\u0435 \u0441\u043F\u0435\u0448\u0438:
      \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u0437\u0430\u043F\u043E\u043C\u043D\u0438,
      \u043F\u043E\u0442\u043E\u043C \u043D\u0430\u0436\u0438\u043C\u0430\u0439.\r\n\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439
      \u043F\u0440\u043E\u0439\u0442\u0438 \u0431\u0435\u0437 \u043E\u0448\u0438\u0431\u043E\u043A!\xBB"
    AudioClip: {fileID: 8300000, guid: fff98409feab11d439c2b360b3d204d1, type: 3}
    VideoClip: {fileID: 32900000, guid: 01a835a9909197f4587defdcb5c374e8, type: 3}
