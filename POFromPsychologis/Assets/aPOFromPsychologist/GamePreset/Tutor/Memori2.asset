  m_Script: {fileID: 11500000, guid: 683afb59319d7ff4785863a4e3cd9bc4, type: 3}
  m_Name: Memori2
  m_EditorClassIdentifier: 
  tutor:
  - Text: "\u0421\u0443\u0442\u044C \u0438\u0433\u0440\u044B \u0438 \u043A\u0430\u043A
      \u0438\u0433\u0440\u0430\u0442\u044C: \xAB\u0412\u043D\u0438\u043C\u0430\u043D\u0438\u0435,
      \u0437\u0430\u0434\u0430\u0447\u0430 \u043D\u0430 \u043F\u043E\u0440\u044F\u0434\u043E\u043A!
      \u0417\u0430\u043F\u043E\u043C\u043D\u0438, \u043A\u0430\u043A \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0438
      \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u044B \u0432 \u0432\u0435\u0440\u0445\u043D\u0435\u043C
      \u0440\u044F\u0434\u0443. \u041F\u043E\u0442\u043E\u043C \u043D\u0430\u0436\u043C\u0438
      \xAB\u041F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0442\u044C\xBB \u2014
      \u043E\u043D\u0438 \u0441\u043E\u0431\u0435\u0440\u0443\u0442\u0441\u044F \u0432\u043D\u0438\u0437\u0443.
      \u0412\u0435\u0440\u043D\u0438 \u043A\u0430\u0436\u0434\u0443\u044E \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0443
      \u043D\u0430 \u0435\u0451 \u043F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0435
      \u043C\u0435\u0441\u0442\u043E!\xBB "
    AudioClip: {fileID: 0}
    VideoClip: {fileID: 32900000, guid: dda9f888a497f74488f7cbe4dc06fc6a, type: 3}
  - Text: "\u0427\u0430\u0441\u0442\u044B\u0435 \u043E\u0448\u0438\u0431\u043A\u0438
      \u0438 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438: \xAB\u0421\u043E\u0432\u0435\u0442\u0443\u044E
      \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0442\u044C \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0438, \u043D\u043E \u0438 \u0438\u0445
      \u0441\u043E\u0441\u0435\u0434\u0435\u0439: \u2014 \u0415\u0441\u043B\u0438
      \u043F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u043B \u043D\u0435 \u0442\u0443\u0434\u0430
      \u2014 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0430 \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F
      \u0432\u043D\u0438\u0437. \u2014 \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
      \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u0430\u044F \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0430
      \u0437\u0430\u0444\u0438\u043A\u0441\u0438\u0440\u0443\u0435\u0442\u0441\u044F.
      \u2014 \u041C\u043E\u0436\u043D\u043E \u043D\u0430\u0447\u0430\u0442\u044C
      \u0441 \u0442\u0435\u0445, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E\u043C\u043D\u0438\u0448\u044C
      \u0442\u043E\u0447\u043D\u043E. \u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438
      \u043F\u043E\u0440\u044F\u0434\u043E\u043A!\xBB "
    AudioClip: {fileID: 0}
    VideoClip: {fileID: 32900000, guid: 8523696788767714189f3f14c0959906, type: 3}
