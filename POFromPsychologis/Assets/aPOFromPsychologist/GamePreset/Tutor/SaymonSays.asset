  m_Script: {fileID: 11500000, guid: 683afb59319d7ff4785863a4e3cd9bc4, type: 3}
  m_Name: SaymonSays
  m_EditorClassIdentifier: 
  tutor:
  - Text: "\u0421\u0443\u0442\u044C \u0438\u0433\u0440\u044B \u0438 \u043A\u0430\u043A
      \u0438\u0433\u0440\u0430\u0442\u044C: \xAB\u0421\u044B\u0433\u0440\u0430\u0435\u043C
      \u0432 \xAB\u0412\u0435\u0442\u0440\u0438\u043A \u0433\u043E\u0432\u043E\u0440\u0438\u0442\xBB!
      \u041A\u0440\u0443\u0433 \u043F\u043E\u043A\u0430\u0436\u0435\u0442 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u0446\u0432\u0435\u0442\u043E\u0432 \u2014 \u0437\u0430\u043F\u043E\u043C\u043D\u0438
      \u0435\u0451. \u0417\u0430\u0442\u0435\u043C \u043F\u043E\u0432\u0442\u043E\u0440\u0438
      \u044D\u0442\u0443 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C,
      \u043D\u0430\u0436\u0438\u043C\u0430\u044F \u043D\u0430 \u0446\u0432\u0435\u0442\u0430
      \u0432\u043D\u0438\u0437\u0443. \u0421 \u043A\u0430\u0436\u0434\u044B\u043C
      \u0440\u0430\u0443\u043D\u0434\u043E\u043C \u0446\u0435\u043F\u043E\u0447\u043A\u0430
      \u0431\u0443\u0434\u0435\u0442 \u0434\u043B\u0438\u043D\u043D\u0435\u0435!\xBB"
    AudioClip: {fileID: 0}
    VideoClip: {fileID: 32900000, guid: dda9f888a497f74488f7cbe4dc06fc6a, type: 3}
  - Text: "\u0427\u0430\u0441\u0442\u044B\u0435 \u043E\u0448\u0438\u0431\u043A\u0438
      \u0438 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438: \xAB\u0412\u043A\u043B\u044E\u0447\u0438
      \u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E \u0438 \u0441\u043B\u0443\u0445\u043E\u0432\u0443\u044E
      \u043F\u0430\u043C\u044F\u0442\u044C: \u2014 \u041A\u0430\u0436\u0434\u044B\u0439
      \u0446\u0432\u0435\u0442 \u0437\u0432\u0443\u0447\u0438\u0442 \u0441\u0432\u043E\u0435\u0439
      \u043D\u043E\u0442\u043E\u0439, \u044D\u0442\u043E \u043F\u043E\u043C\u043E\u0436\u0435\u0442.
      \u2014 \u0415\u0441\u043B\u0438 \u043E\u0448\u0438\u0431\u0451\u0448\u044C\u0441\u044F
      \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
      \u2014 \u0438\u0433\u0440\u0430 \u043D\u0430\u0447\u043D\u0451\u0442\u0441\u044F
      \u0437\u0430\u043D\u043E\u0432\u043E. \u2014 \u041D\u0435 \u0441\u043F\u0435\u0448\u0438,
      \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u0437\u0430\u043F\u043E\u043C\u043D\u0438,
      \u043F\u043E\u0442\u043E\u043C \u043D\u0430\u0436\u0438\u043C\u0430\u0439.
      \u0421\u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u0431\u0438\u0442\u044C
      \u0440\u0435\u043A\u043E\u0440\u0434?\xBB"
    AudioClip: {fileID: 0}
    VideoClip: {fileID: 32900000, guid: 9d24740fe02f44f4ab05fe5a5e393f6b, type: 3}
